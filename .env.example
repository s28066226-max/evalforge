# All free. Set the keys for the providers you use; without them EvalForge runs in mock mode.

# Groq (default provider): free, no credit card. https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini: free tier. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter: free models end in ":free". https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Ollama runs models locally and needs no key. Override if it isn't on the default port.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional: where results are stored (default: data/evalforge.db)
EVALFORGE_DB=

# Optional: dashboard data source. "local" = the SQLite database, "published" = data/published.json.
# Default: local when the database file exists, otherwise published (as on a deployment).
EVALFORGE_SOURCE=

# Optional: live arena settings
# ARENA_MODELS=groq:openai/gpt-oss-20b,groq:qwen/qwen3.8-27b
# ARENA_JUDGE=groq:openai/gpt-oss-120b
# ARENA_RATE_LIMIT=6
# ARENA_DISABLED=1

# Optional: shows a GitHub link in the header
# NEXT_PUBLIC_GITHUB_URL=https://github.com/<you>/evalforge
